APP_ENV=production
APP_NAME=AIVAN HRMS API
DATABASE_URL=postgresql+psycopg://hrms:CHANGE_ME@db:5432/hrms
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD
JWT_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
BACKEND_CORS_ORIGINS=https://hrms.aivan.com
FRONTEND_URL=https://hrms.aivan.com
AUTO_CREATE_TABLES=false
AUTO_SEED_ROLES=false
AUTO_SEED_DEMO_DATA=false
ENABLE_SCHEDULER=true
EXPOSE_RESET_LINK_IN_RESPONSE=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=no-reply@aivan.com
HTTP_PORT=80
