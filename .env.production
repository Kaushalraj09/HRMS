# ==============================================================================
# AIVAN HRMS - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# INSTRUCTIONS:
# 1. Update POSTGRES_PASSWORD with a secure cryptographically random string.
# 2. Update JWT_SECRET_KEY with a secure random string (minimum 32 characters).
# 3. Update SMTP credentials with your production email delivery provider.
# 4. Do NOT enable AUTO_CREATE_TABLES, AUTO_SEED_ROLES, or AUTO_SEED_DEMO_DATA.
# ==============================================================================

# Core Application Settings
APP_ENV=production
APP_NAME=AIVAN HRMS API

# Database Connection (PostgreSQL Production)
DATABASE_URL=postgresql+psycopg://hrms:CHANGE_ME_IN_PRODUCTION_PASSWORD@db:5432/hrms
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_PASSWORD

# Authentication & Security
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_JWT_SECRET_MIN_32_CHARACTERS_LONG
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=hrms_access_token
SESSION_COOKIE_SECURE=true

# Domains & CORS (Production HTTPS Only)
BACKEND_CORS_ORIGINS=https://hrms.aivan360.com
FRONTEND_URL=https://hrms.aivan360.com

# Production Bootstrap Guardrails (Strictly Disabled)
AUTO_CREATE_TABLES=false
AUTO_SEED_ROLES=false
AUTO_SEED_DEMO_DATA=false
ENABLE_SCHEDULER=true
EXPOSE_RESET_LINK_IN_RESPONSE=false

# SMTP Service Configuration (Required in Production for Safe Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@aivan360.com
SMTP_PASSWORD=CHANGE_ME_SMTP_PASSWORD
SMTP_FROM=no-reply@aivan360.com

# Network Ports
HTTP_PORT=80
HTTPS_PORT=443
