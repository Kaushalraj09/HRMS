# ==============================================================================
# AIVAN HRMS - PRODUCTION ENVIRONMENT TEMPLATE (.env.production.example)
# ==============================================================================
# INSTRUCTIONS FOR PRODUCTION DEPLOYMENT:
# 1. Copy this template to .env.production on your production server:
#    cp .env.production.example .env.production
# 2. Generate a secure cryptographically random JWT secret (min 32 chars):
#    python -c "import secrets; print(secrets.token_urlsafe(48))"
# 3. Update POSTGRES_PASSWORD with your production PostgreSQL password.
# 4. Update SMTP credentials with your production email delivery service.
# 5. Verify BACKEND_CORS_ORIGINS and FRONTEND_URL use HTTPS domains.
# 6. NEVER commit the real .env.production containing secrets to version control.
# ==============================================================================

# Core Application Settings
APP_ENV=production
APP_NAME=AIVAN HRMS API

# Database Connection (PostgreSQL Production)
DATABASE_URL=postgresql+psycopg://hrms:REPLACE_WITH_STRONG_DB_PASSWORD@db:5432/hrms
POSTGRES_DB=hrms
POSTGRES_USER=hrms
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# Authentication & Security
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_CRYPTOGRAPHIC_KEY_MIN_32_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
SESSION_COOKIE_NAME=hrms_access_token
SESSION_COOKIE_SECURE=true

# Domains & CORS (Production HTTPS Only)
BACKEND_CORS_ORIGINS=https://hrms.aivan360.com
FRONTEND_URL=https://hrms.aivan360.com

# Production Bootstrap Guardrails (Strictly Disabled)
AUTO_CREATE_TABLES=false
AUTO_SEED_ROLES=false
AUTO_SEED_DEMO_DATA=false
ENABLE_SCHEDULER=true
EXPOSE_RESET_LINK_IN_RESPONSE=false

# SMTP Service Configuration (Required in Production for Secure Activation & Password Resets)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=alerts@aivan360.com
SMTP_PASSWORD=REPLACE_WITH_REAL_SMTP_APP_PASSWORD
SMTP_FROM=no-reply@aivan360.com

# Network Ports
HTTP_PORT=80
HTTPS_PORT=443
